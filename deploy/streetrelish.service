[Unit]
Description=StreetRelish V1
After=network.target

[Service]
Type=simple
User=streetrelish
Group=streetrelish
WorkingDirectory=/opt/street-relish
Environment=STREETRELISH_HOST=127.0.0.1
Environment=STREETRELISH_PORT=8787
ExecStart=/opt/street-relish/.venv/bin/python /opt/street-relish/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
